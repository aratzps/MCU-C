(footprint "T_FLYBACK_EQ30"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Custom flyback transformer T601 per PI DER-948Q T1: MyCoilTech MCT-EIQ3001 V4+6P vertical bobbin on Ferroxcube EQ30 + PLT30/20/3 (3C96). 4-pin primary row (pins 1-4, 5.0 mm pitch; pins 2 and 4 removed after winding per DER-948Q, no holes fitted) opposite 6-pin secondary row (pins 5-10, 5.0 mm pitch), row spacing 26.8 mm per MyCoilTech EQ30/EIQ30 catalog data [TBV against MCT-EIQ3001 bobbin drawing at transformer RFQ]. Numbering: primary row left-to-right 1-4 (top), secondary row right-to-left 5-10 (bottom), pin 1 top-left. Windings per DER-948Q: pri 25T pins 1(start)-3(finish), bias 2T pins 5(start)-6(finish) inverse direction, sec 15V 2T pins 8(start)-9(finish); pins 7 and 10 present but unused. Body 31.1 x 29.0 mm, height 17.2 mm max. Drill 1.4 mm for ~1.0 mm bobbin pins.")
	(tags "flyback transformer EQ30 EIQ30 MCT-EIQ3001 DER-948Q InnoSwitch3-AQ THT")
