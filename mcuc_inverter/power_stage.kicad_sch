		(uuid "adbca253-718d-4121-85e5-d69cf20ca311")
	)
	(text "FS02MR12A8MA2B (D016): 1200 V / 390 A CoolSiC six-pack, HybridPACK Drive G2. Datasheet Fig. 1: switches 1/2 = phase U HS/LS, 3/4 = V, 5/6 = W."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8ef2635b-4a8c-44f9-93d4-be9a35b945c1")
	)
	(text "Dx = drain-sense pins (DESAT reference). Sx.1/Sx.2 = duplicate Kelvin-source pins, tied together; gate-drive return = KSRC_* net. TSx = temp-sense diode per phase (2.624 V @ 0.2 mA / 25 C, current-source bias, not an NTC)."
		(exclude_from_sim no)
		(at 20 32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c4d692d9-d400-41b3-8081-b60bf4664167")
	)
