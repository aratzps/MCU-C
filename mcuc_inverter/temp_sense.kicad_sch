	)
	(text "SPEC.md 8.3, DECISIONS.md D022. Two NTC channels (coldplate + board) and provision-only pads for the module TS diodes. Motor-winding temperature front end is on the Position feedback sheet."
		(exclude_from_sim no)
		(at 20 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "db82ea24-40fd-4b9f-8212-ffd956c5dfeb")
	)
	(text "Coldplate NTC - primary module thermal protection (D022): TDK B57861S0103F040 (10k 1%, B25/100 = 3988 K, glass bead, AEC-Q200)\nbolted at the module baseplate, chassis harness to J1101 (D021). 10k 0.1% bias from +3.3 V: 1.65 V at 25 C, ~0.53 V at 80 C. Read as VESC 'MOSFET temp';\nconservative trip threshold + DESAT backstop cover the unread TS diodes (SPEC 9.1 overtemp)."
		(exclude_from_sim no)
		(at 20 40.64 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left bottom)
		)
		(uuid "f57f208d-9761-446e-9c32-88cdc973f2be")
	)
